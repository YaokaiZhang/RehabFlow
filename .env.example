# Canonical local configuration. Copy this file to the repository root as .env.
# Root .env is read by FastAPI, Product Next, Console Next, launchers, and
# configuration-aware scripts. Process environment values take precedence.
REHAB_REVIEWER_TIMEOUT_SECONDS=40
# Existing backend/.env and workspace dotenv files remain legacy fallbacks.
#
# Keep infrastructure/backend settings separate from browser-visible transport
# settings. Never commit the copied root .env or put real credentials here.

# Ports are not configured here. Pass them to the start command instead, e.g.
#   ./start-dev-apptainer.sh --product-port 3005 --backend-port 8005
#   ./start-dev.sh --product-port 3005 --backend-port 8005
# (see --help for the full list). The launchers ignore *_PORT values in .env.

# Infrastructure and backend-only settings
APP_NAME=rehab-agent-api
# Allowed values: test, development, production.
ENVIRONMENT=dev
FRONTEND_ORIGIN=http://localhost:3000
DEBUG=false
TRACING_ENABLED=true

# DATABASE_URL is the canonical application and Alembic target.
DATABASE_URL=postgresql://<USER>:<PASSWORD>@localhost:5432/rehab_agent
# Legacy POSTGRES_URL is optional and must identify the same host, port, and database.
POSTGRES_URL=postgresql+psycopg2://<USER>:<PASSWORD>@localhost:5432/rehab_agent
CHECKPOINT_DATABASE_URL=postgresql://<USER>:<PASSWORD>@localhost:5432/rehab_agent
REDIS_URL=redis://localhost:6379/0

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PATH=
QDRANT_COLLECTION_NAME=rehab_knowledge
QDRANT_VECTOR_SIZE=1024

# Optional override for the bundled exercise catalog JSONL.
EXERCISE_CATALOG_PATH=

# The embeddings client uses the OpenAI-compatible protocol; this example targets Qwen.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# Chat/LLM calls (router, consultant, reviewers, memory, triage summary, web
# search) use the Anthropic API. LLM_KEY is an Anthropic API key (sk-ant-...).
LLM_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Thinking is on by default for Claude models; effort sets its depth:
# low | medium | high | xhigh | max. Higher effort is slower and costs more.
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback to another Claude model (true/false).
# Not available for Haiku models; ignored there.
ANTHROPIC_FALLBACKS=true
# Optional proxy/gateway; leave unset for https://api.anthropic.com.
# ANTHROPIC_BASE_URL=
# The LLM-judge eval (scripts/run_llm_judge_eval.sh) generates with LLM_KEY
# and judges with LLM_JUDGE_KEY, which defaults to LLM_KEY.
# LLM_JUDGE_KEY=
# OpenAI-compatible settings are used only for embeddings (Anthropic has no
# embeddings API).
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=10

# Replace these placeholders only in an ephemeral local environment.
JWT_SECRET_KEY=generate-a-unique-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
REHAB_TRACE_HMAC_KEY=generate-a-dedicated-trace-hmac-key
REHAB_TRACE_HMAC_KEY_VERSION=v1
STREAM_TICKET_TTL_SECONDS=60

# LLM tracing to a self-hosted Langfuse (see backend/README.md).
# `./start-dev.sh` starts Langfuse and enables this for the Compose backend
# automatically (`--no-langfuse` skips it). Set these only for a backend run
# outside Compose. Langfuse receives full prompts and outputs; it is refused in
# production unless LANGFUSE_ALLOW_PRODUCTION=true. Tracing is on by default and
# starts once both keys are set; set LANGFUSE_ENABLED=false to turn it off.
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Read graph prompts from Langfuse prompt management (also passed to the
# Compose backend). Prompts missing from Langfuse, or whose {{variables}} differ
# from backend/app/ai/prompt_defaults.py, fall back to the in-code defaults.
LANGFUSE_PROMPTS_ENABLED=false
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60

# Browser-visible transport settings
# Full-URL overrides remain authoritative when explicitly configured.
# REHAB_BACKEND_BASE=http://127.0.0.1:8000
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# NEXT_PUBLIC_WS_BASE=ws://127.0.0.1:8000

# Placeholder-only request values for local diagnostics; never use real values here.
AUTHORIZATION_HEADER=Bearer <PLACEHOLDER_ACCESS_TOKEN>
STREAM_TICKET=<SINGLE_USE_TICKET>
